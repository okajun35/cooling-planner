{
  "name": "cooling-planner",
  "version": "0.8.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "build": "tsc && node scripts/build-portable.mjs",
    "build:portable": "npm run build",
    "start": "node scripts/serve.mjs",
    "test:browser": "python -m pytest tests/e2e -v"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
